# Copy this to .env and fill in your values
# NEVER commit .env to git

# LLM Provider (Groq is the only provider — no OpenAI)
GROQ_API_KEY=your-key-here

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=your-key-here
LANGFUSE_SECRET_KEY=your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com  # or self-hosted URL

# Qdrant Cloud (deployment vector DB; local dev uses Chroma)
QDRANT_URL=your-qdrant-cloud-url
QDRANT_API_KEY=your-key-here

# App config
LOG_LEVEL=INFO
ENVIRONMENT=development
VECTOR_BACKEND=chroma           # chroma (local dev) | qdrant (deployment)
RETRIEVER_NAME=dense            # dense | bm25 | hybrid | hybrid-rerank (dense won the eval)
COLLECTION_NAME=complaints_bge
BM25_PATH=data/processed/bm25_index.pkl
